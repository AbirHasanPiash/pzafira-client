# Copy to `.env.local` (git-ignored) and adjust for your environment.
#
# Only VITE_-prefixed variables reach the browser bundle, and everything in that
# bundle is public — never put secrets here. Payment keys, admin credentials and
# private tokens belong in the backend.

# Base URL of the Pzafira API.
# Leave unset to use the hosted production API.
# Local Django server: http://127.0.0.1:8000
VITE_API_BASE_URL=https://pzafira-cloth-store.vercel.app
